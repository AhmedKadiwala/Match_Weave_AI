# Everything is local. No paid API key is accepted.
MATCHWEAVE_PROVIDER=deterministic
MATCHWEAVE_LOCAL_URL=http://127.0.0.1:5273/v1
MATCHWEAVE_MODEL=qwen2.5-1.5b-instruct-generic-cpu:4
MATCHWEAVE_TIMEOUT=45
VITE_API_URL=http://127.0.0.1:8000

# Deployment settings are set in the host dashboard or process environment.
MATCHWEAVE_DEPLOYMENT=local
# For Render: set exact production HTTPS origin, no wildcard.
# MATCHWEAVE_CORS_ORIGINS=https://YOUR-ACTUAL-FRONTEND.vercel.app
# MATCHWEAVE_ALLOWED_HOSTS=YOUR-ACTUAL-BACKEND.onrender.com
