{
  "$defs": {
    "EventType": {
      "enum": [
        "pass",
        "reception",
        "carry",
        "shot",
        "goal",
        "tackle",
        "interception",
        "clearance",
        "recovery",
        "turnover",
        "possession_change",
        "pressure",
        "foul",
        "set_piece",
        "substitution",
        "metadata"
      ],
      "title": "EventType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "pattern": "^[a-z0-9_-]{1,80}$",
      "title": "Event Id",
      "type": "string"
    },
    "match_id": {
      "pattern": "^[a-z0-9_-]{1,50}$",
      "title": "Match Id",
      "type": "string"
    },
    "sequence_number": {
      "minimum": 0,
      "title": "Sequence Number",
      "type": "integer"
    },
    "period": {
      "enum": [
        1,
        2
      ],
      "title": "Period",
      "type": "integer"
    },
    "match_clock_ms": {
      "maximum": 5400000,
      "minimum": 0,
      "title": "Match Clock Ms",
      "type": "integer"
    },
    "team_id": {
      "title": "Team Id",
      "type": "string"
    },
    "player_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Player Id"
    },
    "event_type": {
      "$ref": "#/$defs/EventType"
    },
    "start_x": {
      "maximum": 105,
      "minimum": 0,
      "title": "Start X",
      "type": "number"
    },
    "start_y": {
      "maximum": 68,
      "minimum": 0,
      "title": "Start Y",
      "type": "number"
    },
    "end_x": {
      "maximum": 105,
      "minimum": 0,
      "title": "End X",
      "type": "number"
    },
    "end_y": {
      "maximum": 68,
      "minimum": 0,
      "title": "End Y",
      "type": "number"
    },
    "outcome": {
      "default": "complete",
      "enum": [
        "complete",
        "incomplete",
        "on_target",
        "off_target",
        "scored",
        "neutral"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "related_event_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "title": "Related Event Ids",
      "type": "array"
    },
    "event_attributes": {
      "additionalProperties": true,
      "title": "Event Attributes",
      "type": "object"
    },
    "synthetic_metadata": {
      "additionalProperties": true,
      "title": "Synthetic Metadata",
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "match_id",
    "sequence_number",
    "period",
    "match_clock_ms",
    "team_id",
    "event_type",
    "start_x",
    "start_y",
    "end_x",
    "end_y"
  ],
  "title": "Event",
  "type": "object"
}